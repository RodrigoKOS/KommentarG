# Modo simples (Places API New) - para testar já
# Pegue em Google Cloud -> APIs -> Credenciais
GOOGLE_MAPS_API_KEY=
# RG da empresa no Google (veja README como descobrir)
GOOGLE_PLACE_ID=
# Vários clientes: padrão + lista liberada separada por vírgula (opcional)
# Ex: GOOGLE_ALLOWED_PLACES=ChIJAAA,ChIJBBB
GOOGLE_ALLOWED_PLACES=

# DeepSeek (resumo IA) - pegue em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Opcional: deepseek-v4-flash (barato, padrão) ou deepseek-v4-pro (melhor)
DEEPSEEK_MODEL=deepseek-v4-flash

